#!/bin/bash

clear_last_line () {
  printf '\033[1A\033[K'
}

print_processing () {
  printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

print_success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

print_fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1"
}

print_info () {
  printf "\r  [\033[00;34mINFO\033[0m] %s\n" "$1"
}

print_empty_line () {
  echo ""
}

run_linter () {
  LINT_COMMAND="npm run lint:staged"
  if ! $LINT_COMMAND; then # don't trash output, it's nice to see
    print_fail "Linter failed! To see the details, run '$LINT_COMMAND' manually."
    print_empty_line
    exit 1
  fi
}

echo ""
print_info "Running pre-commit checks..."

# ===== STAGES =====
run_linter
# ==================

print_empty_line
print_success "Completed pre-commit checks"
exit 0