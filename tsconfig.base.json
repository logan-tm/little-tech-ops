{
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "exclude": ["node_modules"]
}
